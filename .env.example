# Copy to backend/.env (or export as env vars) to override defaults.
# All variables are prefixed with APP_.

APP_SUMO_MODE=managed          # managed | remote
APP_SUMO_BINARY=sumo           # sumo | sumo-gui
APP_SUMO_CONFIG=/sumo/demo.sumocfg
APP_SUMO_HOST=sumo             # remote mode only
APP_SUMO_PORT=8813             # remote mode only
APP_USE_LIBSUMO=false
APP_STEP_LENGTH=1.0

# Geo-anchor for synthetic networks without a projection (ENU origin)
APP_ORIGIN_LON=-79.0045
APP_ORIGIN_LAT=-2.9006

# WebSocket frame-rate cap
APP_MAX_FPS=10
