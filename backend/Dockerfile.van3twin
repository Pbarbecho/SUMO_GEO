# Backend SUMO-GEO para el modo van3twin (remote): NO instala el binario SUMO
# (eclipse-sumo), por lo que tampoco necesita las libs X11/GL del Dockerfile
# normal. Solo traci/sumolib puros pinados a la versión del contenedor van3twin.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-van3twin.txt .
RUN pip install --no-cache-dir -r requirements-van3twin.txt
COPY app ./app
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
